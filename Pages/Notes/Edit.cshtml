@page
@model HW5NoteKeeper.Pages.Notes.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Note</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Note.Id" />
            <input type="hidden" asp-for="Note.UserRealmId" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Note.Summary" class="control-label"></label>
                <input asp-for="Note.Summary" class="form-control" aria-required="true"/>
                <span asp-validation-for="Note.Summary" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Note.Details" class="control-label"></label>
                <textarea asp-for="Note.Details" class="form-control" rows="5" aria-required="true"></textarea>
                <span asp-validation-for="Note.Details" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
