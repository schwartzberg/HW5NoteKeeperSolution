@page
@model HW5NoteKeeper.Pages.Notes.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Note</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Note.Summary)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Note.Summary)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Note.Details)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Note.Details)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Note.CreatedDateUtc)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Note.CreatedDateUtc)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Note.ModifiedDateUtc)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Note.ModifiedDateUtc)
        </dd>
        <dt class="col-sm-2">
            Tags
        </dt>
        <dd class="col-sm-10">
            @if (Model.Note.Tags != null && Model.Note.Tags.Any())
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var tag in Model.Note.Tags)
                    {
                        <li><span class="badge bg-secondary">@tag.Name</span></li>
                    }
                </ul>
            }
            else
            {
                <span class="text-muted">No tags</span>
            }
        </dd>
    </dl>
</div>

@* ── Attachments section ── *@
<div class="mt-4">
    <h4>Attachments</h4>
    <hr />

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Attachments.Any())
    {
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>Original File Name</th>
                    <th>Blob Name</th>
                    <th>Content Type</th>
                    <th>Size</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var attachment in Model.Attachments)
                {
                    <tr>
                        <td>@attachment.OriginalFileName</td>
                        <td>
                            <a asp-page="./Details"
                               asp-page-handler="Download"
                               asp-route-id="@Model.Note.Id"
                               asp-route-attachmentId="@attachment.BlobName">@attachment.BlobName</a>
                        </td>
                        <td>@attachment.ContentType</td>
                        <td>@((attachment.Length / 1024.0).ToString("N1")) KB</td>
                        <td>
                            <form method="post" asp-page-handler="Delete"
                                  asp-route-id="@Model.Note.Id"
                                  asp-route-attachmentId="@attachment.BlobName"
                                  style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No attachments.</p>
    }

    <form method="post" asp-page-handler="Upload" asp-route-id="@Model.Note.Id" enctype="multipart/form-data" class="mt-3">
        <div class="input-group" style="max-width: 500px;">
            <input type="file" name="file" class="form-control" />
            <button type="submit" class="btn btn-primary">Upload</button>
        </div>
    </form>
</div>

<div class="mt-3">
    <a asp-page="./Edit" asp-route-id="@Model.Note.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
