@page
@model HW5NoteKeeperSolution.Pages.Notes.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Note</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Note.Summary)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Note.Summary)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Note.Details)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Note.Details)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Note.CreatedDateUtc)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Note.CreatedDateUtc)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Note.ModifiedDateUtc)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Note.ModifiedDateUtc)
        </dd>
        <dt class="col-sm-2">
            Tags
        </dt>
        <dd class="col-sm-10">
            @if (Model.Note.Tags != null && Model.Note.Tags.Any())
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var tag in Model.Note.Tags)
                    {
                        <li><span class="badge bg-secondary">@tag.Name</span></li>
                    }
                </ul>
            }
            else
            {
                <span class="text-muted">No tags</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Note.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
