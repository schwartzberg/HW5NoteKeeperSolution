@page
@model HW5NoteKeeperSolution.Pages.Notes.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Note</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Note.Summary)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Note.Summary)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Note.Details)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Note.Details)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Note.CreatedDateUtc)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Note.CreatedDateUtc)
        </dd>
        <dt class="col-sm-2">
            Tags
        </dt>
        <dd class="col-sm-10">
            @if (Model.Note.Tags != null && Model.Note.Tags.Any())
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var tag in Model.Note.Tags)
                    {
                        <li><span class="badge bg-secondary">@tag.Name</span></li>
                    }
                </ul>
            }
            else
            {
                <span class="text-muted">No tags</span>
            }
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Note.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
